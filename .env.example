# ---- PRO-TUNING: environment ----
# Режим данных приложения.
#   mock   — локальное хранилище браузера (localStorage), работает без бэкенда (сейчас)
#   supabase — облачный бэкенд Supabase (следующий этап)
VITE_DATA_MODE=mock

# ---- Supabase (будут использоваться на этапе подключения бэкенда) ----
# Скопируйте из проекта Supabase: Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=